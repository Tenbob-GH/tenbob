# WebSocket — Testnet default. One-line mainnet switch: wss://xrplcluster.com
NEXT_PUBLIC_XRPL_WS=wss://s.altnet.rippletest.net:51233

# Optional Clio endpoint for nft_info / nfts_by_issuer (rippled testnet does not serve these)
NEXT_PUBLIC_XRPL_CLIO_WS=wss://clio.altnet.rippletest.net:51233

# Marketplace broker. Leave empty for direct trades (0% platform fee).
NEXT_PUBLIC_BROKER_ADDRESS=
BROKER_SEED=
NEXT_PUBLIC_BROKER_FEE_BPS=150

# Xaman (Xumm) — required to enable Xaman connect / sign
XUMM_API_KEY=
XUMM_API_SECRET=

# Optional IPFS pinning. Without this, paste an HTTPS or ipfs:// image URL.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# App URL used when minting metadata hosted on this server
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev-only Testnet seed. UI is hidden unless NODE_ENV=development. Never use on mainnet.
NEXT_PUBLIC_DEV_SEED=
